<?xml version="1.0" encoding="utf-8"?>
<!-- Some stream mirrors and subtitle hosts are plain HTTP; the player must reach them. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
